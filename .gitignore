# Virtual machine images
output/
*.qcow2
*.img
*.raw
*.iso

# Private SSH keys and test credentials
keys/
*.pem
*.key

# Local NoCloud test data
nocloud-test/
nocloud-ssh-test/

# Local files
*.log
*.bak
*.old

# Generated Debian root filesystem
/build/rootfs/

# Other generated build artifacts
/build/*.tar
/build/*.tar.gz
/build/*.tar.xz

# Local secrets and credentials
**/id_rsa
**/id_ed25519
**/authorized_keys
**/shadow
**/shadow-
**/machine-id

# Website dependencies and generated files
website/node_modules/
website/dist/
website/test-results/
website/playwright-report/
website/.env*
!website/.env.example
.vercel/

# All intermediate OS build files (not source)
/build/
__pycache__/
*.pyc

# Staged downloadable CI bundle
/ci-artifacts/

# Smoke diagnostics (runner-writable even when output is root-owned)
/smoke-diagnostics/

# CI host package/appliance cache
/.ci-cache/

# Rust utility build output
/vpsctl/target/
